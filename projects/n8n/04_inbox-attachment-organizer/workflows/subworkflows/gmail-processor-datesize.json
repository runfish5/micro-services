        "limit": "={{ $('Config').first().json.email_limit || 500 }}",
        "filters": {
          "q": "={{ $('Config').first().json.query }}",
          "receivedAfter": "={{ $json.start }}",
          "receivedBefore": "={{ $json.end }}"
        }
