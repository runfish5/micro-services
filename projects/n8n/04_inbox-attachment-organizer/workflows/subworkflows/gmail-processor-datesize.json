    {
      "parameters": {
        "jsCode": "// One item per date window. The Gmail search runs once per item,\n// so a big mailbox is fetched in small pieces instead of one huge request.\nconst c = $('Config').first().json;\n\nconst day = d => d.toISOString().split('T')[0];\n// Window ends are exclusive dates (Gmail 'before:'). Tomorrow in UTC, so today is always\n// included. ($today is local midnight: east of UTC, +1 day of it is still today.)\nconst end = new Date(Date.now() + 86400000);\n\n// size mode: one window over all time, email_limit caps it\nif (c.batch_mode === 'size') {\n  return [{ json: { start: '2000-01-01', end: day(end) } }];\n}\n\n// date mode: lookback_days back from today, in interval_days steps\nconst windows = [];\nlet cur = new Date(Date.now() - c.lookback_days * 86400000);\nwhile (cur < end) {\n  const next = new Date(cur);\n  next.setDate(next.getDate() + c.interval_days);\n  windows.push({ json: { start: day(cur), end: day(next > end ? end : next) } });\n  cur = next;\n}\nreturn windows;"
      },
      "type": "n8n-nodes-base.code",
      "position": [
        560,
        304
      ],
      "id": "479ee25f-ad17-5129-9c32-fc69321719da",
      "name": "Build Date Windows",
