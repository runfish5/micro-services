# Railway variables of the database growth guard (paste into the service's Raw Editor).
#
# The service is built from this repository:
#   Source          this GitHub repo
#   Root Directory  projects/n8n/14_db-janitor      (its Dockerfile is found there)
#   Volume          none
#   Networking      "Generate Domain" only if the outside heartbeat should check the guard
#
# ${{...}} are Railway references: they resolve inside your own project, so they are safe to
# copy as they are. "Postgres" and "Primary" must match the names of your services.
#
# Only DATABASE_URL is required. With it alone the guard runs in observe mode and writes its
# alerts to the deploy log and to the table guard.event.

DATABASE_URL="${{Postgres.DATABASE_URL}}"

# Where alerts go. The token comes from @BotFather; the chat id is the chat the bot writes to.
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"
TELEGRAM_CHAT_ID="YOUR_CHAT_ID_1"

# observe = report only. enforce = also switch workflows off and stop their runs.
GUARD_MODE="observe"

# n8n itself. The URL also enables the "n8n is not ready" alert. The key is needed for enforce:
# create it in n8n under Settings > n8n API; it must be allowed to read and unpublish workflows
# and to stop executions.
N8N_BASE_URL="https://${{Primary.RAILWAY_PUBLIC_DOMAIN}}"
N8N_API_KEY="YOUR_N8N_API_KEY"

# Overrides of service/config.json, as one JSON object. overhead_mb: what the host counts on the
# volume beyond databases and write-ahead log. factors: multiply both limits for one workflow id.
GUARD_CONFIG="{\"volume_mb\":500,\"overhead_mb\":0,\"factors\":{}}"

# Optional: every alert also as an email (for Gmail: an app password).
# SMTP_URL="smtps://smtp.gmail.com:465"
# SMTP_USER="you@example.com"
# SMTP_PASS="YOUR_SMTP_PASSWORD"
# MAIL_TO="you@example.com"

# Optional: serve /status.json on the generated domain, for the outside heartbeat.
# PORT="8080"
