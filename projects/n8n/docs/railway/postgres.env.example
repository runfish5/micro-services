# Railway variables of the Postgres service (paste into the service's Raw Editor).
#
# ${{...}} are Railway references: they resolve inside your own project, so they are safe to
# copy as they are. Only POSTGRES_PASSWORD is a secret: generate your own, once, and never
# change it afterwards. Changing the variable does not change the password inside an existing
# database, and n8n then cannot log in.
#
# Not variables, but part of the same setup (service Settings):
#   Image          ghcr.io/railwayapp-templates/postgres-ssl, PostgreSQL 16, pinned by digest so a
#                  redeploy can never pull a newer major version
#   Start command  /bin/sh -c "unset PGPORT; docker-entrypoint.sh postgres --port=5432"
#   Volume         mounted at /var/lib/postgresql/data (500 MB here; see ../infra-ops.md)
#
# n8n reaches this service through the references in primary.env.example and worker.env.example
# (DB_POSTGRESDB_HOST="${{Postgres.PGHOST}}" and so on). The service must be named "Postgres"
# for those references to resolve.

DATABASE_URL="postgres://${{POSTGRES_USER}}:${{POSTGRES_PASSWORD}}@${{PGHOST}}:${{PGPORT}}/${{POSTGRES_DB}}"
PGDATA="/var/lib/postgresql/data/pgdata"
PGDATABASE="${{POSTGRES_DB}}"
PGHOST="${{RAILWAY_PRIVATE_DOMAIN}}"
PGPASSWORD="${{POSTGRES_PASSWORD}}"
PGPORT="5432"
PGUSER="${{POSTGRES_USER}}"
POSTGRES_DB="railway"
POSTGRES_PASSWORD="YOUR_POSTGRES_PASSWORD"
POSTGRES_USER="railway"
SSL_CERT_DAYS="820"
