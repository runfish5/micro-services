    {
      "parameters": {
        "jsCode": "// Where the row goes: over the row that holds the same key, else at the end.\nconst call = $('When Called').first().json;\nconst cfg = $('Set Store Config').first().json;\nconst values = $input.first().json.values || [];\nconst header = (values[0] || []).map(String);\nif (!header.includes('at')) throw new Error('Tab ' + call.table + ' needs a header row with an at column');\n\nconst row = { ...call.row, at: $now.toUTC().toISO() };\nconst missing = Object.keys(row).filter((f) => !header.includes(f));\nif (missing.length) throw new Error('Tab ' + call.table + ' has no column ' + missing.join(', '));\n\nconst base = 'https://sheets.googleapis.com/v4/spreadsheets/' + cfg.spreadsheet_id + '/values/' + encodeURIComponent(call.table);\nlet at = -1;\nif (call.key) {\n  const col = header.indexOf(call.key);\n  if (col < 0) throw new Error('Tab ' + call.table + ' has no column ' + call.key);\n  at = values.findIndex((r, i) => i > 0 && String(r[col] ?? '') === String(row[call.key] ?? ''));\n}\n// A keyed row keeps the fields this call does not name.\nconst kept = at > 0 ? Object.fromEntries(header.map((h, i) => [h, values[at][i] ?? ''])) : {};\nconst whole = { ...kept, ...row };\nconst cell = (v) => (v === null || v === undefined ? '' : typeof v === 'object' ? JSON.stringify(v) : v);\nconst cells = header.map((h) => cell(whole[h]));\nreturn [{ json: {\n  row: whole,\n  method: at > 0 ? 'PUT' : 'POST',\n  url: at > 0\n    ? base + encodeURIComponent('!A' + (at + 1)) + '?valueInputOption=RAW'\n    : base + ':append?valueInputOption=RAW&insertDataOption=INSERT_ROWS',\n  body: { values: [cells] },\n} }];"
      },
