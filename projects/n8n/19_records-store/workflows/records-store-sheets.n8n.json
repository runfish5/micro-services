    {
      "parameters": {
        "jsCode": "// One item per row, named by the header. A short row reads as empty cells.\nconst call = $('When Called').first().json;\nconst values = $input.first().json.values || [];\nconst header = (values[0] || []).map(String);\nconst since = call.since ? Date.parse(call.since) : NaN;\nconst at = header.indexOf('at');\nreturn values.slice(1)\n  .filter((r) => !Number.isFinite(since) || Date.parse(String(r[at] ?? '')) >= since)\n  .map((r) => ({ json: Object.fromEntries(header.map((h, i) => [h, r[i] ?? ''])) }));"
      },
      "id": "c9e3a4f2-18a1-4c00-9a01-000000000032",
      "name": "Return Rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1344,
        288
      ]
    },
    {
      "parameters": {
        "url": "=https://sheets.googleapis.com/v4/spreadsheets/{{ $('Set Store Config').first().json.spreadsheet_id }}",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "fields",
              "value": "sheets.properties"
            }
          ]
        },
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleSheetsOAuth2Api",
        "options": {}
      },
      "id": "c9e3a4f2-18a1-4c00-9a01-000000000022",
      "name": "Get Tab Ids",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1344,
        560
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "CREDENTIAL_ID_GOOGLE_SHEETS",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Rows added before the time go, bottom first so the row numbers stay true.\n// A row with a key is the newest word on its subject and has no age.\nconst call = $('When Called').first().json;\nconst values = $('Read Tab').first().json.values || [];\nconst header = (values[0] || []).map(String);\nconst tab = ($input.first().json.sheets || []).map((s) => s.properties).find((p) => p.title === call.table);\nif (!tab) throw new Error('No tab named ' + call.table);\nconst before = Date.parse(call.before);\nif (!Number.isFinite(before)) throw new Error('drop needs a before time');\nconst at = header.indexOf('at');\nconst key = call.key ? header.indexOf(call.key) : -1;\nconst rows = values.map((r, i) => i)\n  .filter((i) => i > 0 && Date.parse(String(values[i][at] ?? '')) < before && !(key >= 0 && String(values[i][key] ?? '')))\n  .sort((a, b) => b - a);\nreturn [{ json: {\n  dropped: rows.length,\n  requests: rows.map((i) => ({ deleteDimension: { range: { sheetId: tab.sheetId, dimension: 'ROWS', startIndex: i, endIndex: i + 1 } } })),\n} }];"
      },
      "id": "c9e3a4f2-18a1-4c00-9a01-000000000033",
      "name": "Plan Deletes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1568,
        560
      ]
    },
