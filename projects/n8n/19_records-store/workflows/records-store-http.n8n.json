      "name": "Find Kept Row",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1472,
        112
      ],
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 5000,
      "credentials": {
        "httpHeaderAuth": {
          "id": "CREDENTIAL_ID_RECORDS_TOKEN",
          "name": "Records token"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// A keyed row keeps the fields this call does not name.\nconst call = $('When Called').first().json;\nconst kept = ($input.first().json.records || [])\n  .find((r) => r.key === String(call.row[call.key] ?? ''));\nreturn [{ json: { row: { ...(kept ? kept.row : {}), ...call.row } } }];"
      },
      "id": "b8d2f3e1-18a1-4c00-9a01-000000000031",
      "name": "Merge Into Kept Row",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1696,
        112
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Set Store Config').first().json.records_url }}/{{ $('When Called').first().json.table }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ row: $json.row, key: $('When Called').first().json.key ? String($json.row[$('When Called').first().json.key] ?? '') : '' }) }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "b8d2f3e1-18a1-4c00-9a01-000000000020",
      "name": "Keep Record",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1920,
        192
