      "credentials": {
        "httpHeaderAuth": {
          "id": "CREDENTIAL_ID_RECORDS_TOKEN",
          "name": "Records token"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// One item per row. The store's time comes back as 'at' beside the row's own fields.\nconst answer = $input.first().json;\nconst records = Array.isArray(answer.records) ? answer.records : [answer];\nreturn records.map((r) => ({ json: { ...r.row, at: r.at } }));"
      },
